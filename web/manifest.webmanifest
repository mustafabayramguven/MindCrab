{
  "name": "MindCrab",
  "short_name": "MindCrab",
  "description": "Self-hosted Markdown notebook and AI memory",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fcf8ff",
  "theme_color": "#6b4fa0",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "text/*",
            ".md"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Bugünün notu",
      "short_name": "Bugün",
      "url": "/#/daily"
    },
    {
      "name": "Görevler",
      "url": "/#/tasks"
    }
  ]
}